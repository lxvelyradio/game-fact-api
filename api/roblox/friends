import axios from "axios";

const FRIENDS = [
  "WheresTheFunYoshida",
  "username026010",
  "LocaBelle",
  "Yorbaeinsummer",
  "Monellz",
  "anaphalis00"
  "calmdwn232"
  "ailerawrr"
  "iitsera"
  "Seobae6"
  "RichSlzr1"
  "belbelle17"
  "HXODST"
  "chomfrr"
  "RaphaelllllX"
];

export default async function handler(req, res) {
  try {
    const results = [];

    for (const username of FRIENDS) {
      const profile = await axios.get(
        `https://game-fact-api.vercel.app/api/roblox/profile?username=${username}`
      );
      results.push(profile.data);
    }

    res.status(200).json(results);
  } catch (err) {
    res.status(500).json({ error: "Failed to fetch friends" });
  }
}
